# /etc/detonation-ocean/env: read by systemd (EnvironmentFile=) as root before the service drops to user `detonation`.
# setup.sh copies this file to /etc/detonation-ocean/env only when that file is missing (mode 0600, root:root),
# and sets APP_PUBLIC_ORIGIN from --host. It never overwrites an existing file.
#
# Format: NAME=value, one per line, no quotes, no `export`, no inline comments.
# Secrets are empty here. Fill them in on the VM with `sudoedit /etc/detonation-ocean/env`; never commit a filled file.
# After any edit: sudo systemctl restart detonation-ocean, then check /api/health.
#
# Do NOT add VULTR_SANDBOX_MODE, VULTR_SANDBOX_APPROVAL, VULTR_API_KEY or VULTR_HACKATHON_MODE. They belong to the older
# per-run Cloud Compute path (docs/vultr-deployment.md, superseded) and would let this server create billable instances.

# Exact public HTTPS origin, no path and no trailing slash. POST /api/jobs is accepted only when the browser's Origin
# header equals this value. Must match the host that Caddy serves.
APP_PUBLIC_ORIGIN=https://detonation.example.invalid

# `true` marks the public site: it switches off the local template-desktop preview server. Keep `true` on the VM.
DETONATION_PRODUCTION=true

# `true` accepts uploads and makes /api/health report acceptingJobs and queueDepth. Kill switch: set `false` and restart;
# the ocean stays visible, uploads get 503, and /api/health shrinks to {"ok":true,"buildId":...}. setup.sh needs `true`.
DETONATION_ENABLED=true

# `true` lets the controller call Vultr Serverless Inference. It also needs a key and a code model below; otherwise
# jobs finish without a model explanation.
DETONATION_INFERENCE_ENABLED=false

# Vultr Serverless Inference key (SECRET). Leave empty until the user approves the key. Redacted from logs.
VULTR_INFERENCE_API_KEY=

# Model ID that writes the analysis Python (confirm the exact ID in the Vultr console).
VULTR_INFERENCE_CODE_MODEL=

# Optional reasoning effort; set only when the selected model supports the requested value.
VULTR_INFERENCE_REASONING_EFFORT=

# Optional: model ID for screenshot checks of HTML and PDF. Empty disables them.
VULTR_INFERENCE_VISION_MODEL=

# Per-inference-client call cap per UTC day, not a site-wide or lifetime budget. The counter is in memory and resets on UTC
# rollover, service restart, or client recreation. At the cap, jobs finish without model analysis/explanation.
# Requests are bounded to a 128 KiB serialized body and 4,096 completion tokens, but bytes are not an exact token or dollar limit.
# For one supervised smoke test only: set this to 7, use DeepSeek V4.1 Flash with reasoning effort `minimal`, submit one benign
# project-written file to one controller, then disable inference and restart the service immediately afterward.
DAILY_INFERENCE_CALL_CAP=300

# 32 random bytes, 64 hex characters (SECRET), for the encrypted job temp files. Optional: when empty, the controller
# draws a fresh random key on every start, which is safe because job files never outlive a process. To pin one:
#   openssl rand -hex 32
UPLOAD_ENCRYPTION_KEY=

# Defaults that rarely need changing (uncomment to override):
# DETONATION_DATA_DIR=/var/lib/detonation-ocean
# DETONATION_DETONATE_IMAGE=detonation-ocean/detonate
# DETONATION_COLLECT_IMAGE=detonation-ocean/collect
# DETONATION_ANALYSE_IMAGE=detonation-ocean/analyse
# PORT=4173
