# detonation-ocean/analyse: pandas, matplotlib and the harness (docs/SPEC.md 6.1, section 8).
FROM python:3.12-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f

RUN pip install --no-cache-dir pandas==2.3.3 matplotlib==3.10.7

COPY analyse/harness.py /opt/detonation/harness.py

# The python base image sets GPG_KEY (its release-signing fingerprint); blank it so no *KEY variable carries a value.
ENV GPG_KEY= MPLBACKEND=Agg MPLCONFIGDIR=/tmp PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
WORKDIR /out
ENTRYPOINT ["python", "/opt/detonation/harness.py"]
