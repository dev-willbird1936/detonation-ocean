# Text files are LF in the working tree on every OS, so hashes recorded in manifests match a Linux clone.
* text=auto eol=lf

# Windows launchers and mail need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.eml text eol=crlf

# Renderer licence texts: ui/abyss/manifest.json hashes the upstream CRLF bytes, and tools/refresh-abyss-manifest.mjs leaves those entries alone.
ui/abyss/LICENSE-dioramas.txt text eol=crlf
ui/abyss/LICENSE-lenis.txt text eol=crlf

